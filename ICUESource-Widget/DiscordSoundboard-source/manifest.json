{
  "author": "Guillermo",
  "id": "com.guillermo.discordsoundboard",
  "name": "Discord Soundboard",
  "description": "Tap grid of your Discord soundboard sounds, played into voice via a local bot agent",
  "version": "1.7.0",
  "preview_icon": "resources/icon.svg",
  "min_framework_version": "1.0.0",
  "min_app_version": "5.47",
  "os": [
    {
      "platform": "windows"
    }
  ],
  "supported_devices": [
    {
      "type": "dashboard_lcd",
      "features": [
        "sensor-screen"
      ]
    },
    {
      "type": "keyboard_lcd"
    },
    {
      "type": "pump_lcd"
    }
  ],
  "interactive": true
}