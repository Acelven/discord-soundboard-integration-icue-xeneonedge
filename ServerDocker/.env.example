# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored - docker-compose.yml and docker-compose.ghcr.yml both
# read from it automatically via ${VAR} substitution, so real secrets never
# need to be typed into a tracked file.

DISCORD_TOKEN=your-discord-bot-token-here
API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
